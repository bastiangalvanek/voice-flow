# ── Required ─────────────────────────────────────────────────────────
# OpenAI API Key (used for Whisper transcription).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Optional ─────────────────────────────────────────────────────────
# Anthropic API Key (enables Claude cleanup of transcribed text:
# typo correction, proper-noun fixes from context.txt, etc.).
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Overrides (CLI flags override these) ────────────────────────────
# VOICE_FLOW_HOTKEY=f8                           # push-to-talk key
# VOICE_FLOW_LANGUAGE=auto                       # ISO code (e.g. de, en) or "auto"
# VOICE_FLOW_WHISPER_MODEL=gpt-4o-mini-transcribe   # ~4x faster than whisper-1
# VOICE_FLOW_CLEANUP_MODEL=claude-haiku-4-5-20251001
# VOICE_FLOW_AUDIO_DEVICE=1                      # index from --list-devices
# VOICE_FLOW_ENABLE_CLEANUP=1                    # set to 1 to enable Claude cleanup
